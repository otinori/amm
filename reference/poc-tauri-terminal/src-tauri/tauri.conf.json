{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "poc-tauri-terminal",
  "version": "0.1.0",
  "identifier": "dev.amm.poc-tauri-terminal",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "conpty-native",
        "title": "poc-tauri-terminal (native ConPTY via portable-pty)",
        "url": "conpty-native.html",
        "width": 900,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
